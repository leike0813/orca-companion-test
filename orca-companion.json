    "codexSandbox": "danger-full-access",
    "git": {
      "remotes": [
        "origin"
      ],
      "refs": [
        "refs/heads/e2e29-integration"
      ]
    },
    "limits": {
      "maxActiveWorkPackages": 1,
      "concurrencyLimit": 1,
      "implementationAttempts": 2,
      "validatorRepairs": 1,
      "maxRecoveriesPerWorkerAttempt": 1
    },
    "acceptedRisks": [
      "codex-sandbox-danger-full-access"
    ]
  }
